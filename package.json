{
	"name": "pi-ollama-provider",
	"version": "0.1.0",
	"description": "Native Ollama provider for Pi: local and Ollama Cloud through the Ollama API",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"ollama",
		"provider"
	],
	"pi": {
		"extensions": [
			"./extensions/ollama/index.ts"
		]
	},
	"files": [
		"extensions",
		"src",
		"vendor",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"lint": "eslint",
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"vendor:check": "node scripts/vendor-check.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "22.19.19",
		"eslint": "^10.14.0",
		"neostandard": "^0.14.1",
		"typescript": "^6.0.3",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
